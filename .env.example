# Application
NODE_ENV=development
PORT=3000
APP_ORIGIN=http://localhost:3000
SESSION_SECRET=replace-with-a-long-random-secret
LOG_LEVEL=info

# Authentication/session settings
SESSION_COOKIE_NAME=ec2web.sid
SESSION_MAX_AGE_MS=86400000

# SSH policy
SSH_DEFAULT_PORT=22
SSH_CONNECT_TIMEOUT_MS=15000
SSH_IDLE_TIMEOUT_MS=1800000
SSH_MAX_SESSION_DURATION_MS=28800000
SSH_MAX_SESSIONS_PER_USER=3
SSH_ALLOWED_HOSTS=
SSH_ALLOWED_CIDRS=

# Secret provider configuration should be supplied via deployment identity/secret manager.
# Do not add private keys, passphrases, or real credentials to this file.
